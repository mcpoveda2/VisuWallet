# WhatsApp Bot Configuration
# Copia este archivo a .env y completa con tus credenciales reales

# Puerto del servidor
PORT=3000

# WhatsApp Business API (Meta Cloud API)
# Obtener en: https://developers.facebook.com/apps
WHATSAPP_TOKEN=tu_token_de_acceso_aqui
WHATSAPP_PHONE_ID=tu_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_aqui

# Gemini AI (Google)
# Obtener en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
